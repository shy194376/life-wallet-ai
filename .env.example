# 使用说明：
# 1. 复制本文件为 .env；
# 2. 将 DEEPSEEK_API_KEY 替换为自己的 DeepSeek API Key；
# 3. 保存后重新运行 start.bat。

# 默认大模型提供方，可选 deepseek 或 openai。
LLM_PROVIDER=deepseek

# DeepSeek OpenAI 兼容接口。
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 启动后自动连接并定时心跳，断线后自动重连，用户无需手动操作。
DEEPSEEK_KEEPALIVE_ENABLED=true
DEEPSEEK_HEARTBEAT_SECONDS=30
DEEPSEEK_RECONNECT_SECONDS=5

# 默认禁止静默降级到本地规则引擎，确保智能咨询始终由 DeepSeek 提供。
# 仅在明确需要离线演示时改为 true。
ALLOW_LOCAL_FALLBACK=false

# 如需切换回 OpenAI，将 LLM_PROVIDER 改为 openai，并填写以下配置。
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-3.5-turbo-1106

# 云平台会自动注入 PORT；本地默认使用 5000。
# PORT=5000
